@inject BibliotecaMicroservice.Services.SnackbarService SnackbarService
@implements IDisposable

@if (SnackbarService.IsVisible)
{
    <div class="fixed bottom-8 right-8 z-[200] animate-slide-up">
        <div class="border-4 border-on-background shadow-[6px_6px_0px_0px_#1d1b1f] p-4 flex items-center gap-3 @(SnackbarService.IsError ? "bg-[#ffdad6] text-[#93000a]" : "bg-[#ccc460] text-on-background")">
            <span class="material-symbols-outlined font-black">
                @(SnackbarService.IsError ? "error" : "check_circle")
            </span>
            <span class="font-label-md font-bold uppercase tracking-wider text-sm">
                @SnackbarService.Message
            </span>
        </div>
    </div>
}

<style>
    @@keyframes slide-up-snackbar {
        0% { transform: translateY(100px); opacity: 0; }
        100% { transform: translateY(0); opacity: 1; }
    }
    .animate-slide-up {
        animation: slide-up-snackbar 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }
</style>

@code {
    protected override void OnInitialized()
    {
        SnackbarService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        SnackbarService.OnChange -= StateHasChanged;
    }
}