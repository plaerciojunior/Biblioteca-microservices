@using BibliotecaMicroservice.Models
@inject BibliotecaMicroservice.Handlers.LoanHandler LoanHandler
@inject BibliotecaMicroservice.Handlers.BookHandler BookHandler
@inject BibliotecaMicroservice.Services.AuthService AuthService
@inject BibliotecaMicroservice.Services.SnackbarService SnackbarService

@implements IDisposable

<aside class="hidden xl:block w-[320px] shrink-0 h-fit border-2 border-on-background bg-surface-container-lowest neo-shadow p-6 sticky top-[120px]">
    <h3 class="font-headline-md text-headline-md border-b-2 border-on-background pb-2 mb-4">Empréstimos Rápidos</h3>
    
    <div class="flex flex-col gap-4">
        @if (ActiveLoans.Count == 0)
        {
            <p class="font-body-md text-on-surface-variant text-sm">Nenhum empréstimo ativo.</p>
        }
        @foreach (var loan in ActiveLoans)
        {
            <div class="flex gap-4 items-start border-2 border-transparent hover:border-on-background p-2 transition-all group">
                <div class="w-12 h-16 border-2 border-on-background bg-secondary-container shrink-0 flex items-center justify-center">
                    <span class="material-symbols-outlined text-on-background">menu_book</span>
                </div>
                <div class="flex-1">
                    <h4 class="font-label-md text-label-md leading-tight group-hover:text-primary transition-colors uppercase">@loan.BookTitle</h4>
                    @if (loan.IsOverdue)
                    {
                        <p class="font-label-sm text-label-sm text-error mt-1 font-bold">Atrasado!</p>
                    }
                    else
                    {
                        <p class="font-label-sm text-label-sm text-on-surface-variant mt-1 font-bold">No prazo</p>
                    }
                    <button @onclick="() => DevolverLivro(loan.Id)" class="mt-2 text-xs font-bold uppercase underline decoration-2 underline-offset-2 hover:text-primary transition-colors">
                        Devolver
                    </button>
                </div>
            </div>
        }
    </div>

    <a href="/my-loans" class="block text-center w-full mt-6 border-2 border-on-background bg-surface px-4 py-2 font-label-md text-label-md font-bold neo-shadow hover:bg-primary-container transition-all">
        Meus Empréstimos
    </a>
</aside>

@code {
    private List<Loan> ActiveLoans = new();

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        LoanHandler.OnLoansChanged += AtualizarEmprestimos;
        await CarregarEmprestimos();
    }

    private async void AtualizarEmprestimos()
    {
        await CarregarEmprestimos();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        LoanHandler.OnLoansChanged -= AtualizarEmprestimos;
    }

    private async Task CarregarEmprestimos()
    {
        if (AuthService.CurrentUserId == null) return;
        var loans = await LoanHandler.GetUserLoansAsync(AuthService.CurrentUserId.Value);
        if (loans != null)
        {
            ActiveLoans.Clear();
            foreach (var l in loans)
            {
                if (l.status == "ativo")
                {
                    var book = await BookHandler.GetBookAsync(l.livro_id);
                    var loanDate = DateTime.TryParse(l.data_emprestimo, out var d) ? d : DateTime.Now;
                    ActiveLoans.Add(new Loan
                    {
                        Id = l.id,
                        BookTitle = book?.nome ?? "Desconhecido",
                        IsOverdue = DateTime.Now > loanDate.AddDays(14)
                    });
                }
            }
        }
    }

    private async Task DevolverLivro(int loanId)
    {
        var result = await LoanHandler.ReturnLoanAsync(loanId);
        if (result)
        {
            SnackbarService.Show("Livro devolvido com sucesso!");
        }
        else
        {
            SnackbarService.Show("Erro ao devolver livro.", true);
        }
    }
}