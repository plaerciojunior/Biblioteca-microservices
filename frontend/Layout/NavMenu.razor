@inject BibliotecaMicroservice.Services.AuthService AuthService
@inject NavigationManager NavManager
@inject BibliotecaMicroservice.Handlers.LoanHandler LoanHandler
@implements IDisposable

<aside class="hidden lg:flex flex-col h-full w-[260px] border-2 border-on-background bg-surface-container-low py-gutter px-4 shrink-0 neo-shadow sticky top-32" style="height: calc(100vh - 160px);">
    
    <div class="mb-8 flex flex-col gap-4 border-b-2 border-on-background pb-4">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 border-2 border-on-background bg-secondary-container overflow-hidden shrink-0 flex items-center justify-center">
                <span class="material-symbols-outlined">person</span>
            </div>
            <div>
                <h2 class="font-headline-sm font-bold text-on-surface leading-tight">Minha Biblioteca</h2>
                <p class="font-label-sm text-on-surface-variant truncate w-32">@(AuthService.CurrentUserName ?? "Conta de Leitor")</p>
            </div>
        </div>
        
        @if (saldoDevedor > 0)
        {
            <div class="bg-[#ffdad6] border-2 border-on-background p-3 flex flex-col gap-3 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
                <div class="flex items-center justify-between">
                    <span class="font-label-sm font-bold uppercase text-[#93000a] text-[10px]">Saldo Devedor</span>
                    <span class="font-headline-md font-black text-[#93000a]">- R$ @saldoDevedor.ToString("0.00")</span>
                </div>
                <button @onclick="AbrirPagamento" class="w-full bg-white border-2 border-on-background py-2 font-label-sm font-black uppercase text-on-background hover:bg-[#D1B3FF] hover:-translate-y-0.5 hover:-translate-x-0.5 transition-all shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] flex justify-center items-center gap-2">
                    Pagar Multa <span class="material-symbols-outlined text-[16px]">payments</span>
                </button>
            </div>
        }
        else
        {
            <div class="bg-[#e2e8f0] border-2 border-on-background p-2 flex items-center justify-between shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
                <span class="font-label-sm font-bold uppercase text-[#0071c1] text-[10px]">Saldo Atual</span>
                <span class="font-headline-md font-black text-[#0071c1]">R$ 0,00</span>
            </div>
        }
    </div>

    <NavLink class="w-full bg-primary-container border-2 border-on-background py-3 px-4 font-label-md font-bold neo-shadow hover:bg-secondary-container hover:neo-shadow-hover transition-all text-on-surface mb-8 flex justify-center items-center gap-2" href="my-loans">
        <span class="material-symbols-outlined">menu_book</span> Meus Empréstimos
    </NavLink>

    <nav class="flex flex-col gap-2 flex-1 overflow-y-auto">
        <NavLink class="flex items-center gap-3 p-3 text-on-surface-variant hover:bg-surface-variant hover:bg-primary-container hover:text-on-primary-container transition-colors duration-200 active:scale-95 border-2 border-transparent" href="catalog" Match="NavLinkMatch.All">
            <span class="material-symbols-outlined">home</span>
            <span class="font-label-md">Início</span>
        </NavLink>
    </nav>

    <div class="mt-auto pt-4 border-t-2 border-on-background flex flex-col gap-2">
        <button @onclick="Sair" class="flex items-center gap-3 p-3 text-on-surface-variant hover:bg-surface-variant transition-colors duration-200 border-2 border-transparent w-full text-left">
            <span class="material-symbols-outlined">logout</span>
            <span class="font-label-md">Sair</span>
        </button>
    </div>
</aside>

@if (showPaymentModal)
{
    <BibliotecaMicroservice.Layout.PaymentModal AmountDue="@saldoDevedor" OnClose="FecharPagamento" />
}

@code {
    private double saldoDevedor = 0.0;
    private bool showPaymentModal = false;

    protected override async Task OnInitializedAsync()
    {
        AuthService.OnAuthStateChanged += StateHasChanged;
        LoanHandler.OnLoansChanged += AtualizarSaldo;
        AtualizarSaldo();
    }

    private async void AtualizarSaldo()
    {
        if (AuthService.CurrentUserId == null) return;
        var loans = await LoanHandler.GetUserLoansAsync(AuthService.CurrentUserId.Value);
        saldoDevedor = 0.0;
        
        if (loans != null)
        {
            foreach(var l in loans)
            {
                if (l.status == "atrasado" && !string.IsNullOrEmpty(l.data_emprestimo))
                {
                    if (DateTime.TryParse(l.data_emprestimo, out var dtEmp))
                    {
                        var prazo = dtEmp.AddDays(14);
                        if (DateTime.Now > prazo)
                        {
                            var diasAtraso = (DateTime.Now - prazo).Days;
                            if (diasAtraso <= 0) diasAtraso = 1;
                            saldoDevedor += diasAtraso * 2.50; // R$ 2,50 por dia de atraso
                        }
                    }
                }
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    private void AbrirPagamento()
    {
        showPaymentModal = true;
    }

    private void FecharPagamento()
    {
        showPaymentModal = false;
    }

    private async Task Sair()
    {
        await AuthService.LogoutAsync();
        NavManager.NavigateTo("/login");
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= StateHasChanged;
        LoanHandler.OnLoansChanged -= AtualizarSaldo;
    }
}