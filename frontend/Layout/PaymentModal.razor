@inject BibliotecaMicroservice.Handlers.PaymentHandler PaymentHandler
@inject BibliotecaMicroservice.Services.SnackbarService SnackbarService
@inject BibliotecaMicroservice.Services.AuthService AuthService
@inject BibliotecaMicroservice.Handlers.LoanHandler LoanHandler

<!-- Fixed Overlay -->
<div class="fixed inset-0 bg-[#FFF8ED]/80 backdrop-blur-sm flex items-center justify-center p-margin-mobile md:p-margin-desktop z-[200]">
    
    <!-- Modal Card -->
    <div class="bg-[#FFF8ED] border-4 border-on-background shadow-[10px_10px_0px_0px_rgba(29,27,31,1)] max-w-[500px] w-full p-6 md:p-8 relative">
        
        <!-- Header -->
        <div class="flex justify-between items-center mb-6 pb-4 border-b-4 border-on-background">
            <h2 class="font-headline-lg text-3xl font-bold uppercase text-on-background tracking-tighter">PAGAR MULTA POR ATRASO</h2>
            <button @onclick="Fechar" aria-label="Close modal" class="text-on-background hover:text-primary transition-colors cursor-pointer border-2 border-transparent hover:border-on-background hover:bg-surface-variant p-1">
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1; font-size: 32px;">close</span>
            </button>
        </div>
        
        <!-- Body: Summary Section -->
        <div class="bg-surface-container-low border-2 border-on-background p-4 mb-6">
            <p class="font-label-md text-sm text-on-surface-variant mb-1 uppercase tracking-wider font-bold">Resumo da Dívida</p>
            <div class="flex justify-between items-end mt-2">
                <div>
                    <p class="font-headline-md text-xl font-black">Multas Acumuladas</p>
                    <p class="font-body-md text-error font-bold mt-1">Biblioteca Digital Sanctuary</p>
                </div>
                <div class="text-right">
                    <p class="font-label-sm text-xs text-on-surface-variant uppercase font-bold">Multa Total</p>
                    <p class="font-display-lg text-4xl font-black">R$ @AmountDue.ToString("0.00")</p>
                </div>
            </div>
        </div>
        
        <!-- Body: Payment Form -->
        <form class="space-y-4 mb-8" @onsubmit:preventDefault>
            <div>
                <label class="block font-label-md text-sm font-bold uppercase mb-2">Nome do Titular</label>
                <input @bind="CardName" class="w-full bg-white border-2 border-on-background p-3 font-body-md font-bold text-on-background placeholder:text-outline focus:outline-none focus:shadow-[5px_5px_0px_0px_rgba(29,27,31,1)] transition-shadow duration-200" placeholder="JOÃO DA SILVA" type="text"/>
            </div>
            <div>
                <label class="block font-label-md text-sm font-bold uppercase mb-2">Informações do Cartão</label>
                <div class="flex flex-col border-2 border-on-background bg-white focus-within:shadow-[5px_5px_0px_0px_rgba(29,27,31,1)] transition-shadow duration-200">
                    <div class="flex items-center border-b-2 border-on-background p-3">
                        <span class="material-symbols-outlined mr-2 text-on-surface-variant">credit_card</span>
                        <input @bind="CardNumber" class="w-full bg-transparent border-none p-0 font-body-md font-bold focus:outline-none placeholder:text-outline" placeholder="0000 0000 0000 0000" type="text" maxlength="19"/>
                    </div>
                    <div class="flex">
                        <input class="w-1/2 border-none border-r-2 border-on-background p-3 font-body-md font-bold bg-transparent focus:outline-none placeholder:text-outline" placeholder="MM/YY" type="text" maxlength="5"/>
                        <input class="w-1/2 border-none p-3 font-body-md font-bold bg-transparent focus:outline-none placeholder:text-outline" placeholder="CVC" type="password" maxlength="4"/>
                    </div>
                </div>
            </div>
            <div class="flex items-center mt-2 text-on-surface-variant pt-2">
                <span class="material-symbols-outlined mr-1 text-[16px]">lock</span>
                <p class="font-label-sm text-xs font-bold uppercase">Pagamento seguro processado por Stripe (Simulação)</p>
            </div>
        </form>
        
        <!-- Footer -->
        <div class="flex flex-col items-center gap-4">
            <button @onclick="EfetuarPagamento" class="w-full bg-primary-container border-4 border-on-background py-4 font-headline-md text-xl font-black text-on-background uppercase shadow-[5px_5px_0px_0px_rgba(29,27,31,1)] active:translate-x-[3px] active:translate-y-[3px] active:shadow-[2px_2px_0px_0px_rgba(29,27,31,1)] hover:bg-[#D1B3FF] transition-all duration-200 flex justify-center items-center gap-2">
                PAGAR R$ @AmountDue.ToString("0.00") AGORA
            </button>
            <button @onclick="Fechar" class="font-label-md text-sm font-bold text-on-surface-variant hover:text-on-background hover:underline uppercase transition-all mt-2">
                Cancelar Processo
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public double AmountDue { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string CardName { get; set; } = "";
    private string CardNumber { get; set; } = "";

    private Task Fechar() => OnClose.InvokeAsync();

    private async Task EfetuarPagamento()
    {
        if (AuthService.CurrentUserId == null || string.IsNullOrWhiteSpace(CardNumber)) return;

        var success = await PaymentHandler.ProcessPaymentAsync(AuthService.CurrentUserId.Value, AmountDue, CardNumber);
        if (success)
        {
            await LoanHandler.ClearUserFinesAsync(AuthService.CurrentUserId.Value);
            SnackbarService.Show("Pagamento aprovado! Você tem 1 dia para devolver os livros.");
            await Fechar();
        }
        else
        {
            SnackbarService.Show("Erro ao processar o cartão.", true);
        }
    }
}