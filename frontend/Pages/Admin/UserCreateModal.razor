@using BibliotecaMicroservice.Requests.User
@inject BibliotecaMicroservice.Handlers.UserHandler UserHandler
@inject BibliotecaMicroservice.Services.SnackbarService SnackbarService

<div class="fixed inset-0 bg-black/40 backdrop-blur-sm z-50 flex items-center justify-center p-4 md:p-10 overflow-y-auto">
    <div class="bg-[#FFF8ED] w-full max-w-2xl border-4 border-on-background shadow-[12px_12px_0px_0px_#1d1b1f] relative my-auto">
        
        <!-- Header -->
        <div class="border-b-4 border-on-background p-6 flex justify-between items-center bg-[#D1B3FF]">
            <h2 class="font-display-lg text-3xl md:text-4xl font-black uppercase text-on-background m-0 tracking-tighter">Novo Leitor</h2>
            <button @onclick="() => Fechar(false)" class="h-10 w-10 border-4 border-on-background flex items-center justify-center bg-white hover:bg-[#FFB7C5] hover:translate-x-[2px] hover:translate-y-[2px] shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all">
                <span class="material-symbols-outlined font-black text-on-background">close</span>
            </button>
        </div>
        
        <!-- Body -->
        <div class="p-6 md:p-8 flex flex-col gap-6">
            <div class="space-y-2">
                <label class="block font-label-md font-bold uppercase tracking-wider text-sm">Nome Completo</label>
                <input type="text" @bind="RegisterModel.FullName" class="w-full bg-white border-4 border-on-background p-4 font-bold text-lg shadow-[6px_6px_0px_0px_#1d1b1f] focus:outline-none focus:translate-x-[2px] focus:translate-y-[2px] focus:shadow-[4px_4px_0px_0px_#1d1b1f] transition-all" placeholder="Ex: Antonieta Silva" />
            </div>

            <div class="space-y-2">
                <label class="block font-label-md font-bold uppercase tracking-wider text-sm">Email</label>
                <input type="email" @bind="RegisterModel.Email" class="w-full bg-white border-4 border-on-background p-4 font-bold text-lg shadow-[6px_6px_0px_0px_#1d1b1f] focus:outline-none focus:translate-x-[2px] focus:translate-y-[2px] focus:shadow-[4px_4px_0px_0px_#1d1b1f] transition-all" placeholder="toni@exemplo.com" />
            </div>
            
            <div class="space-y-2">
                <label class="block font-label-md font-bold uppercase tracking-wider text-sm">Senha Provisória</label>
                <input type="password" @bind="RegisterModel.Password" class="w-full bg-white border-4 border-on-background p-4 font-bold text-lg shadow-[6px_6px_0px_0px_#1d1b1f] focus:outline-none focus:translate-x-[2px] focus:translate-y-[2px] focus:shadow-[4px_4px_0px_0px_#1d1b1f] transition-all" placeholder="••••••••" />
            </div>
        </div>
        
        <!-- Footer -->
        <div class="border-t-4 border-on-background p-6 bg-surface-variant flex justify-end gap-4">
            <button @onclick="() => Fechar(false)" class="bg-white border-4 border-on-background py-3 px-6 font-label-md font-black uppercase shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all">
                Cancelar
            </button>
            <button @onclick="Salvar" class="bg-[#D1B3FF] border-4 border-on-background py-3 px-8 font-label-md font-black uppercase shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all">
                CRIAR CONTA
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback<bool> OnClose { get; set; }
    private RegisterRequest RegisterModel = new();

    private Task Fechar(bool reload) => OnClose.InvokeAsync(reload);

    private async Task Salvar()
    {
        var result = await UserHandler.RegisterAsync(RegisterModel);
        if (result) { SnackbarService.Show("Leitor criado com sucesso!"); await Fechar(true); }
        else { SnackbarService.Show("Erro ao criar usuário. Email pode já estar em uso.", true); }
    }
}