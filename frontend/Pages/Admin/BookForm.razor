@inject BibliotecaMicroservice.Services.SnackbarService SnackbarService
@inject BibliotecaMicroservice.Handlers.BookHandler BookHandler
@using Microsoft.AspNetCore.Components.Forms

<div class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm p-4 overflow-y-auto">
    
    <div class="relative w-full max-w-4xl bg-[#FFF8ED] border-2 border-on-background shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] p-10 mt-auto mb-auto">

        <button @onclick="Fechar" class="absolute top-10 right-10 p-2 bg-white border-2 border-on-background hover:bg-surface-variant transition-colors shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] z-10 flex items-center justify-center">
            <span class="material-symbols-outlined font-bold text-xl">close</span>
        </button>

        <header class="mb-10 border-b-2 border-on-background pb-6 flex items-center justify-between">
            <div>
                <h1 class="font-headline-lg text-4xl font-black text-on-background tracking-tight">
                    @(IsEditMode ? "Editar Detalhes" : "Adicionar Livro")
                </h1>
            </div>
            
            <div class="mr-16 flex items-center"> <div class="w-14 h-14 border-2 border-on-background bg-[#ccc460] shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] shrink-0 flex items-center justify-center">
                    <span class="material-symbols-outlined text-3xl text-on-background">edit_document</span>
                </div>
            </div>
        </header>

        <div class="space-y-6">
            <div class="space-y-2">
                <label class="block font-label-md font-bold uppercase tracking-wider text-sm">Título</label>
                <input type="text" @bind="Book.Title" class="w-full bg-white border-2 border-on-background p-4 font-body-lg shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] focus:outline-none focus:translate-x-[2px] focus:translate-y-[2px] focus:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all" />
            </div>
            <div class="space-y-2">
                <label class="block font-label-md font-bold uppercase tracking-wider text-sm">Autor</label>
                <input type="text" @bind="Book.Author" class="w-full bg-white border-2 border-on-background p-4 font-body-lg shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] focus:outline-none focus:translate-x-[2px] focus:translate-y-[2px] focus:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all" />
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="space-y-2">
                    <label class="block font-label-md font-bold uppercase tracking-wider text-sm">Categoria</label>
                    <input type="text" @bind="Book.Category" class="w-full bg-white border-2 border-on-background p-4 font-body-lg shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] focus:outline-none focus:translate-x-[2px] focus:translate-y-[2px] focus:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all" placeholder="Ex: Sci-Fi" />
                </div>
                <div class="space-y-2">
                    <label class="block font-label-md font-bold uppercase tracking-wider text-sm">Ano de Publicação</label>
                    <input type="number" @bind="Book.PublishYear" class="w-full bg-white border-2 border-on-background p-4 font-body-lg shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] focus:outline-none focus:translate-x-[2px] focus:translate-y-[2px] focus:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all" />
                </div>
            </div>
            
            <div class="border-t-2 border-on-background pt-6 border-dashed grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
                <div class="space-y-2">
                    <label class="block font-label-md font-bold uppercase tracking-wider text-sm">Disponibilidade</label>
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="checkbox" @bind="Book.IsAvailable" class="w-6 h-6 border-2 border-on-background accent-[#ccc460]" />
                        <span class="font-body-lg font-bold">Livro disponível para novos empréstimos</span>
                    </label>
                </div>
                <div class="space-y-2 bg-[#d1b3ff]/20 p-4 border-2 border-on-background">
                    <label class="block font-label-md font-bold uppercase tracking-wider text-sm flex items-center gap-2">
                        <span class="material-symbols-outlined">upload_file</span> Upload de PDF (Opcional)
                    </label>
                    <InputFile OnChange="HandleFileSelected" accept=".pdf" class="w-full text-sm file:mr-4 file:py-2 file:px-4 file:border-2 file:border-on-background file:text-sm file:font-bold file:bg-surface-lowest file:uppercase hover:file:bg-[#d1b3ff] file:transition-colors cursor-pointer" />
                    @if (!string.IsNullOrEmpty(currentPdfName)) {
                        <p class="text-xs font-bold text-[#864e5a] mt-2">Arquivo atual/selecionado: @currentPdfName</p>
                    }
                </div>
            </div>
        </div>

        <div class="flex justify-between items-center pt-8 mt-10 border-t-2 border-on-background">
            @if (IsEditMode)
            {
                <button class="bg-[#ffdad6] text-[#93000a] border-2 border-on-background px-8 py-4 font-bold uppercase shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] flex items-center gap-2 hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all">
                    <span class="material-symbols-outlined">delete</span> Apagar
                </button>
            }
            else { <div></div> }

            <div class="flex gap-6">
                <button @onclick="Fechar" class="bg-surface-variant border-2 border-on-background px-8 py-4 font-bold uppercase shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all">Cancelar</button>
                <button @onclick="SalvarLivro" class="bg-[#d1b3ff] border-2 border-on-background px-10 py-4 font-bold uppercase shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] flex gap-2 hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all">
                    <span class="material-symbols-outlined">save</span> Salvar
                </button>
            </div>
        </div>

    </div>
</div>

@code {
    [Parameter] public int? BookId { get; set; }
    
    // O Parâmetro de Evento que o componente Pai (Inventory) vai escutar
    [Parameter] public EventCallback OnClose { get; set; }

    private bool IsEditMode => BookId.HasValue;
    private BookFormModel Book = new();
    private IBrowserFile? selectedPdf;
    private string currentPdfName = "";

    protected override async Task OnInitializedAsync()
    {
        if (IsEditMode)
        {
            var b = await BookHandler.GetBookAsync(BookId.GetValueOrDefault());
            if (b != null)
            {
                Book = new BookFormModel { Title = b.nome, Author = b.autor, Category = b.categoria, PublishYear = b.ano_publicacao, IsAvailable = b.disponivel };
                currentPdfName = string.IsNullOrEmpty(b.pdf_url) ? "" : b.pdf_url;
            }
        }
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedPdf = e.File;
        currentPdfName = selectedPdf.Name;
    }

    private Task Fechar()
    {
        return OnClose.InvokeAsync();
    }

    private async Task SalvarLivro()
    {
        var dto = new BibliotecaMicroservice.Handlers.BookDto 
        {
            nome = Book.Title, autor = Book.Author, categoria = Book.Category, 
            ano_publicacao = Book.PublishYear, disponivel = Book.IsAvailable
        };
        
        var savedBook = IsEditMode ? await BookHandler.UpdateBookAsync(BookId.GetValueOrDefault(), dto) : await BookHandler.CreateBookAsync(dto);

        if (savedBook != null)
        {
            if (selectedPdf != null)
            {
                using var content = new MultipartFormDataContent();
                // Aceitando arquivos de até 20MB
                var fileContent = new StreamContent(selectedPdf.OpenReadStream(maxAllowedSize: 1024 * 1024 * 20));
                fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(selectedPdf.ContentType);
                content.Add(fileContent, "file", selectedPdf.Name);
                await BookHandler.UploadPdfAsync(savedBook.id, content);
            }
            
            SnackbarService.Show(IsEditMode ? "Livro atualizado com sucesso!" : "Livro adicionado com sucesso!");
            await Fechar();
        }
        else
        {
            SnackbarService.Show("Erro ao salvar dados do livro.", true);
        }
    }

    public class BookFormModel
    {
        public string Title { get; set; } = "";
        public string Author { get; set; } = "";
        public string Category { get; set; } = "";
        public int PublishYear { get; set; } = DateTime.Now.Year;
        public bool IsAvailable { get; set; } = true;
    }
}